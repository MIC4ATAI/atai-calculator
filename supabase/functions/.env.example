# Zmienne środowiskowe Edge Functions.
# Lokalnie: skopiuj do supabase/functions/.env (plik jest w .gitignore; `supabase functions serve` wczytuje go sam).
# Na produkcji ustawiasz je przez `supabase secrets set NAZWA=wartość` — nigdy w repozytorium.

# GUS (BIR1). Puste = publiczna baza TESTOWA (stare, zanonimizowane dane; wystarcza do rozwoju).
# Klucz produkcyjny: wniosek na regon_bir@stat.gov.pl. Po jego ustawieniu funkcja przechodzi na produkcję.
GUS_API_KEY=

# --- Poczta (kalkulacja po CTA) ---
# Transport: `mailersend` (produkcja; wartość domyślna, gdy zmiennej brak) albo `mailpit` (WYŁĄCZNIE lokalnie —
# lokalna skrzynka deweloperska, podgląd: http://127.0.0.1:54324).
MAIL_TRANSPORT=mailpit

# MailerSend: token API ustawiasz jako sekret Supabase (`supabase secrets set MAILERSEND_API_TOKEN=…`), nigdy w repo.
# Adres nadawcy musi należeć do zweryfikowanej domeny (SPF/DKIM), inaczej MailerSend odrzuci wiadomość (422).
MAILERSEND_API_TOKEN=

# Mailpit widziany z kontenera funkcji; nazwa kontenera zależy od project_id z supabase/config.toml.
MAILPIT_URL=http://supabase_inbucket_atai-calculator:8025

# Nadawca awaryjny, gdy organizacja nie ma własnego (organizations.brand.senderEmail / senderName).
MAIL_FROM_DEFAULT=kalkulator@example.test
MAIL_FROM_NAME=Kalkulator efektywności

# Adres aplikacji w linku do sesji w mailu (rozmówca otwiera go bez logowania). Lokalnie: Vite.
APP_BASE_URL=http://127.0.0.1:5173
