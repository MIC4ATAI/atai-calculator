{
  "name": "atai-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/e2e/tsconfig.json",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:db": "supabase test db",
    "test:e2e": "node scripts/e2e.mjs",
    "functions:prepare": "node scripts/build-functions-vendor.mjs",
    "functions:serve": "npm run functions:prepare && supabase functions serve",
    "functions:deploy": "npm run functions:prepare && supabase functions deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.21.5",
    "exceljs": "^4.4.0",
    "hyperformula": "^3.5.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
