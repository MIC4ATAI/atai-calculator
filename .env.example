# Publiczne wartości Supabase (bezpieczne dla przeglądarki). Tajnych kluczy tu nie wpisujemy.
# Lokalnie: wartości z `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Publiczny adres aplikacji w linkach dla rozmówcy (opcjonalny). Ustaw na produkcji na kanoniczną domenę (np. https://atai.mitax.pl),
# żeby link zawsze otwierał się bez logowania, niezależnie od adresu, z którego loguje się konsultant. Lokalnie zostaw puste.
VITE_PUBLIC_APP_URL=

